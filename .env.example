# Copy to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8742,http://127.0.0.1:8742
SITE_URL=http://localhost:8742

# PostgreSQL (docker compose exposes it on localhost:5432)
DATABASE_URL=postgres://heza:heza@localhost:5432/heza
# Last resort only, when PostgreSQL cannot run: USE_SQLITE=True
USE_SQLITE=False

# Email: console in dev. Production example: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Heza <no-reply@heza.rw>
SUPPORT_EMAIL=support@heza.rw

# Payments. "sandbox" is the built-in test gateway (signed webhooks, no real money).
PAYMENT_PROVIDERS_ENABLED=sandbox,flutterwave
SANDBOX_WEBHOOK_SECRET=sandbox-dev-secret
# inprocess (default) or http (gateway posts the webhook to SITE_URL over the network)
SANDBOX_WEBHOOK_DELIVERY=inprocess
# Flutterwave (test keys start with FLWSECK_TEST-). Leave empty to hide Flutterwave at checkout.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Must match "Secret hash" in the Flutterwave dashboard webhook settings.
FLUTTERWAVE_SECRET_HASH=

# SMS: console logs messages. Africa's Talking: apps.notifications.backends.AfricasTalkingSMSBackend
SMS_BACKEND=apps.notifications.backends.ConsoleSMSBackend
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
WHATSAPP_BACKEND=apps.notifications.backends.ConsoleWhatsAppBackend

# Maps: Leaflet + OpenStreetMap by default. Optional Google key for a Google basemap link.
GOOGLE_MAPS_API_KEY=

# Media: local disk by default. S3-compatible storage for production:
USE_S3=False
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENDPOINT_URL=

# Cache (rate limiting). Use Redis in production with several workers: redis://127.0.0.1:6379/1
CACHE_URL=locmemcache://heza

# Production behind Nginx with HTTPS
SECURE_SSL=False
# Set True only behind Nginx (it overwrites X-Forwarded-For with the real client IP)
USE_X_FORWARDED_FOR=False

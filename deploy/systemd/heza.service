[Unit]
Description=Heza marketplace (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service

[Service]
Type=simple
User=heza
Group=heza
WorkingDirectory=/srv/heza/app
EnvironmentFile=/srv/heza/app/.env
Environment=GUNICORN_BIND=127.0.0.1:8742
ExecStart=/srv/heza/app/.venv/bin/gunicorn heza.wsgi:application -c deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/heza/media /srv/heza/private_media

[Install]
WantedBy=multi-user.target

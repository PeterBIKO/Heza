[Unit]
Description=Heza maintenance: expire holds, complete stays, re-verify pending payments
After=network.target postgresql.service

[Service]
Type=oneshot
User=heza
Group=heza
WorkingDirectory=/srv/heza/app
EnvironmentFile=/srv/heza/app/.env
ExecStart=/srv/heza/app/.venv/bin/python manage.py heza_maintenance
